# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SMTP CONFIGURATION FOR INVITATION EMAIL DISPATCH (/api/send-invite)
# ==============================================================================
# Configure these variables in your .env file to enable live email delivery
# to test inboxes (e.g. your Gmail or internal corporate mailbox).
#
# For Gmail:
# 1. Generate an App Password in your Google Account:
#    Security -> 2-Step Verification -> App Passwords -> Generate ("NOC Portal")
# 2. Paste the 16-character app password into SMTP_PASS (no spaces)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="NOC Operations Portal <no-reply@nocvault.internal>"
